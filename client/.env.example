# Public API origin, without /api. Empty uses the Vite /api proxy in development.
# Production: set to the backend HTTPS origin or configure a same-origin /api reverse proxy.
VITE_API_URL=
# Optional: enables sign in, sign up and account controls. Public key only.
# Copy the Publishable key from the same Clerk instance used by the API.
VITE_CLERK_PUBLISHABLE_KEY=
