    "framer-motion": "10.16.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "7.72.1",
    "react-icons": "4.11.0",
    "react-redux": "8.1.2",
    "react-router-dom": "7.18.3",
