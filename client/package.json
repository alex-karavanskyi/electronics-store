{
  "name": "electronics-store-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x",
    "npm": "12.x"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint src scripts cypress cypress.config.ts vite.config.ts eslint.config.mjs --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest --runInBand",
    "test:e2e": "node scripts/run-e2e.cjs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.167",
    "@clerk/react": "6.18.6",
    "@hookform/resolvers": "7.0.3",
    "@reduxjs/toolkit": "2.14.0",
    "@tanstack/react-query": "5.106.1",
    "ai": "7.0.163",
    "framer-motion": "14.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-icons": "5.7.0",
    "react-redux": "9.3.1",
    "react-router-dom": "7.18.5",
    "sonner": "2.0.8",
    "swiper": "14.4.0",
    "use-debounce": "10.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.22",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "6.2.1",
    "cypress": "16.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "sass": "1.108.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  },
  "packageManager": "npm@12.2.2",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.22": true,
    "cypress@16.2.1": true
  }
}
