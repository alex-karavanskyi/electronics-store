{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm run install:apps",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 180,
      "excludeFiles": "{client/**,server/.env*,server/.migration/**,server/.verification/**,server/tests/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api(?:/|$)|src/|node_modules/|@).*)",
      "destination": "/index.html"
    }
  ],
  "devCommand": "npm --prefix client run dev -- --port $PORT"
}
