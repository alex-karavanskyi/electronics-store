{
  "name": "electronics-store-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x",
    "npm": "12.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint src tests eslint.config.mjs --max-warnings 0",
    "test:mongodb": "tsx --test tests/integration/*.test.ts",
    "setup:favorites": "tsx src/scripts/prepare-favorites.ts",
    "setup:products": "tsx src/scripts/prepare-products.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.109",
    "@clerk/express": "2.1.88",
    "ai": "7.0.163",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "mongoose": "9.12.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "@eslint/js": "10.0.1",
    "globals": "17.14.0"
  },
  "packageManager": "npm@12.2.2",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
