PORT=3001
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Required server-side MongoDB connection string; never expose in VITE_*.
MONGODB_URI=
# Optional: enables the product chat.
OPENAI_API_KEY=
# Optional as a pair. Without both keys, public browsing works and /api/me returns 503.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional PEM public key for networkless session verification (not the Secret key).
CLERK_JWT_KEY=
# Optional Telegram notification settings. Missing/invalid settings do not block publication.
# Create a bot with @BotFather and press Start in your private chat with it.
TELEGRAM_BOT_TOKEN=
# Positive numeric private chat ID; not a username or phone number.
TELEGRAM_ADMIN_CHAT_ID=
PUBLIC_SITE_URL=https://volt-electronics-store.vercel.app
# Separate random secret (32+ characters) for the scheduled HTTP request.
PRODUCT_NOTIFICATIONS_CRON_SECRET=
